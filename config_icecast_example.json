{
  "icecast": {
    "id": "radio1",
    "type": "icecast",
    "host": "radio1.example.com",
    "port": 8000,
    "timeout": 15,
    "check_interval": 60,
    "use_https": false,
    "verify_ssl": true,
    "user_agent": "IcecastChecker/1.0",
    "endpoint": "/admin/stats",
    "endpoint_only": false,
    "auth": {
      "username": "RADIO1_ADMIN_USERNAME",
      "password": "RADIO1_ADMIN_PASSWORD",
      "enabled": true
    },
    "streams": [
      {
        "mount_point": "/main",
        "name": "Radio1 Main",
        "enabled": true
      },
      {
        "mount_point": "/backup",
        "name": "Radio1 Backup",
        "enabled": true
      }
    ]
  },
  "telegram": {
    "bot_token": "RADIO1_TELEGRAM_BOT_TOKEN",
    "chat_id": "RADIO1_TELEGRAM_CHAT_ID",
    "enabled": true
  },
  "email": {
    "enabled": false,
    "smtp_host": "smtp.yourmail.com",
    "smtp_port": 587,
    "use_tls": true,
    "username": "your_smtp_login",
    "password": "your_smtp_password",
    "from_addr": "monitor@yourdomain.com",
    "to_addr": "alerts@yourdomain.com",
    "subject_prefix": "[IcecastChecker]"
  },
  "logging": {
    "log_file": "/var/log/scripts/check_streaming/{YYYY}-{MM}-{DD}-radio1_icecast.log",
    "log_level": "DEBUG",
    "max_file_size": 10485760,
    "backup_count": 5
  },
  "status_json": {
    "enabled": true,
    "file_path": "status-online.json",
    "update_interval": 30
  },
  "notifications": {
    "retry_attempts": 3,
    "retry_delay": 30,
    "cooldown_period": 300
  }
}

